<div class="w-72 py-2">
  <div class="flex flex-col items-center gap-2 px-4 pt-2 pb-4 text-center">
    <%= user_avatar(current_user.email_address, "#1b69d8", "white") %>

    <div>
      <p class="font-semibold text-neutral-900">
        <!-- TODO: Replace with actual user name -->
        <%= current_user.email_address %>
      </p>

      <p class="text-sm text-neutral-500">
        <%= current_user.email_address %>
      </p>
    </div>

    <%= link_to store_root_url(subdomain: @store&.slug), target: "_blank", class: "mt-2 flex w-full items-center justify-center gap-2 rounded-full border border-neutral-200 px-4 py-2 text-sm font-medium text-neutral-800 shadow-xs hover:bg-neutral-50" do %>
      Ver mi tienda
    <% end %>
  </div>

  <div class="border-t border-neutral-100 py-2">
    <%= link_to admin_settings_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50" do %>
      <%= render_svg("currency_dollar.svg", styles: "w-4 h-4") %> Pagos y subscripciones
    <% end %>
  </div>

  <div class="border-t border-neutral-100 py-2">
    <%= link_to edit_admin_storefront_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50" do %>
      <%= render_svg("paint.svg", styles: "w-4 h-4") %> Personalizar tienda
    <% end %>
  </div>

  <div class="border-t border-neutral-100 pt-2">
    <% if @current_plan == "Basico" %>
      <div class="mx-3 my-3 rounded-xl bg-primary p-4">
        <p class="font-semibold text-white">
          Crece a <span class="font-serif text-accent italic">Pro</span>
        </p>

        <p class="mt-1 mb-4 text-xs leading-relaxed text-gray-300">
          Dominio propio, descuentos y reportes avanzados.
        </p>

        <%= render Buttons::Component.new(
                    text: "Ver planes",
                    variant: :accent,
                    size: :xs,
                    href: admin_settings_path,
                  ) %>
      </div>
    <% end %>

    <%= button_to session_path, method: :delete, class: "flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2 text-left text-sm text-red-600 transition-colors hover:bg-red-50" do %>
      <span class="flex h-8 w-8 items-center justify-center"><%= render_svg("logout.svg", styles: "w-4 h-4 text-red-500") %></span>
      Cerrar sesión
    <% end %>
  </div>
</div>
