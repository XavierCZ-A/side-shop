<% content_for :title, "Nuevo producto" %>

<main class="min-h-screen bg-background">
  <header class="border-b border-gray-200 bg-white px-4 md:px-8">
    <div class="mx-auto flex h-20 max-w-7xl items-center gap-4">
      <%= render Buttons::Component.new(
          variant: :outline,
          icon_only: true,
          icon: render_svg("chevron_left.svg", styles: "h-4 w-4"),
          href: admin_products_path,
      ) %>

      <div>
        <%= render Breadcrumb::Component.new(
          items: [
            { label: "Productos", href: admin_products_path },
            { label: "Nuevo producto", href: new_admin_product_path },
          ],
          separator: :chevron
        ) %>

        <h1 class="text-2xl font-bold text-primary">Nuevo producto</h1>
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-5xl px-4 py-8 md:px-8">
    <%= render "form", product: @product %>
  </div>
</main>
