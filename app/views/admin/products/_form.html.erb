<%= form_with(model: [:admin, product], class: "space-y-6") do |form| %>
  <%# ---------- Información ---------- %>
  <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-5 text-base font-semibold text-primary">Información</h2>

    <div class="mb-5">
      <%= form.label :name, "Nombre del producto",
            class: "mb-2 block text-xs font-medium uppercase tracking-wider text-gray-400" %>

      <%= form.text_field :name,
            placeholder: "Ej. Tazón ondas — terracota",
            class: "form-control #{'error' if product.errors[:name].any?}" %>

      <%= display_field_errors(product, :name) %>
    </div>

    <div>
      <%= form.label :description, "Descripción",
            class: "mb-2 block text-xs font-medium uppercase tracking-wider text-gray-400" %>

      <%= form.text_area :description,
            rows: 4,
            placeholder: "Describe materiales, tamaños, colores disponibles...",
            class: "form-control resize-none #{'error' if product.errors[:description].any?}" %>

      <%= display_field_errors(product, :description) %>
    </div>
  </section>

  <section
    class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm"
    data-controller="image-preview"
    data-image-preview-max-files-value="2"
  >
    <div class="mb-1 flex items-center justify-between">
      <h2 class="text-base font-semibold text-primary">Fotos y media</h2>
      <span data-image-preview-target="counter" class="text-xs text-gray-400">0 / 2</span>
    </div>

    <p class="mb-4 text-xs tracking-wide text-gray-400 uppercase">arrastra para reordenar · la 1ª es la principal</p>

    <div
      data-image-preview-target="dropzone"
      data-action="dragover->image-preview#dragOver dragleave->image-preview#dragLeave drop->image-preview#drop"
      class="
        relative cursor-pointer rounded-xl border-2 border-dashed border-gray-200 bg-[#fafafa] p-8 text-center
        transition-all hover:border-accent
      "
      onclick="this.querySelector('input[type=file]').click()"
    >
      <div data-placeholder>
        <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-sm">
          <%= render_svg("photo.svg", styles: "h-5 w-5 text-gray-400") %>
        </span>

        <p class="text-sm text-gray-600">
          Arrastra imágenes o <span class="font-medium text-accent">explora archivos</span>
        </p>

        <p class="mt-1 text-xs tracking-wide text-gray-400 uppercase">PNG · JPG · WEBP — hasta 10 MB c/u</p>
      </div>

      <%= form.file_field :images,
            multiple: true,
            accept: "image/jpeg,image/png,image/webp",
            data: { image_preview_target: "input", action: "change->image-preview#selectFiles" },
            class: "sr-only",
            direct_upload: true %>
    </div>

    <% if product.persisted? && product.images.attached? %>
      <div class="mt-4 flex flex-wrap gap-3">
        <% product.images.each_with_index do |img, i| %>
          <div class="relative h-20 w-20 overflow-hidden rounded-xl shadow-sm ring-1 ring-gray-200">
            <%= image_tag img, alt: product.name, class: "h-full w-full object-cover" %>

            <% if i.zero? %>
              <span
                class="
                  absolute top-1 left-1 rounded bg-primary px-1.5 py-0.5 text-[9px] font-semibold tracking-wide
                  text-white uppercase
                "
              >
                Principal
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div data-image-preview-target="preview" class="mt-4 flex flex-wrap gap-3"></div>

    <%= display_field_errors(product, :images) %>
  </section>

  <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-5 text-base font-semibold text-primary">Precio y Stock</h2>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :price, "Precio",
              class: "mb-2 block text-xs font-medium uppercase tracking-wider text-gray-400" %>

        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm text-gray-400">$</span>

          <%= form.text_field :price,
                placeholder: "0.00",
                class: "form-control pl-7 pr-12 #{'error' if product.errors[:price].any?}" %>

          <span class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-xs text-gray-400 uppercase">
            MXN
          </span>
        </div>

        <%= display_field_errors(product, :price) %>
      </div>

      <div>
        <%= form.label :stock, "Stock",
              class: "mb-2 block text-xs font-medium uppercase tracking-wider text-gray-400" %>

        <%= form.number_field :stock,
              min: 0,
              step: 1,
              placeholder: "0",
              class: "form-control #{'error' if product.errors[:stock].any?}" %>

        <%= display_field_errors(product, :stock) %>
      </div>
    </div>

    <label class="mt-5 flex items-center gap-2.5 text-sm text-gray-700">
      <%= form.check_box :active,
            class: "h-4 w-4 rounded border-gray-300 text-accent focus:ring-accent" %>
      Producto activo (visible en la tienda)
    </label>
  </section>

  <div class="flex items-center justify-end gap-3">
    <%= render Buttons::Component.new(
          text: "Cancelar",
          variant: :secondary,
          href: admin_products_path
        ) %>

    <%= render Buttons::Component.new(
          text: product.persisted? ? "Actualizar producto" : "Crear producto",
          type: "submit",
          data: { turbo_submits_with: "Guardando..." }
        ) %>
  </div>
<% end %>
