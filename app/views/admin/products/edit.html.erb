<% content_for :title, "Editar producto" %>

<main class="min-h-screen bg-background">
  <header class="border-b border-gray-200 bg-white px-4 md:px-8">
    <div class="mx-auto flex h-20 max-w-5xl items-center gap-4">
      <%= link_to admin_products_path,
            class: "flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 transition hover:bg-gray-50" do %>
        <%= render_svg("arrow_left.svg", styles: "h-4 w-4") %>
      <% end %>

      <div>
        <nav class="flex items-center gap-1.5 text-xs text-gray-400">
          <%= link_to "Productos", admin_products_path, class: "hover:text-gray-600" %>
          <span>›</span>
          <span class="text-gray-500">Editar</span>
        </nav>
        <h1 class="text-2xl font-bold text-primary"><%= @product.name %></h1>
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-5xl px-4 py-8 md:px-8">
    <%= render "form", product: @product %>
  </div>
</main>
