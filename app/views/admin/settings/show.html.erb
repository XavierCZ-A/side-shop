<% content_for :title, "Kubo - Configuración" %>

<%= render Tabs::Component.new do |c| %>
  <% c.with_tab(label: "Suscripción", id: "subscription", active: true) do %>
    <%= render "admin/settings/tabs/subscription",
      plans: @plans,
      charges: @charges,
      subscription: @subscription,
      current_plan: @current_plan,
      default_method: @default_method %>
  <% end %>

  <% c.with_tab(label: "Pasarelas de pago", id: "gateways") do %>
    <%= render "admin/settings/tabs/gateway",
          stripe_connected: @stripe_connected,
          mercado_pago_connected: @mercado_pago_connected %>
  <% end %>
<% end %>
