<div
  data-dropdown-target="menu"
  class="
    pointer-events-none absolute top-full right-0 z-50 mt-2 hidden w-80 -translate-y-2 overflow-hidden rounded-2xl
    bg-white opacity-0 shadow-xl ring-1 ring-black/5 transition-all duration-200 ease-out
  "
>
  <div class="bg-accent px-4 py-4">
    <div class="flex items-center gap-3">
      <div
        class="
          flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-base font-semibold
          text-primary
        "
      >
        <%= current_user.store.name.first.upcase %>
      </div>

      <div class="min-w-0 flex-1">
        <p class="truncate text-base font-semibold text-white"><%= current_user.store.name.capitalize %></p>
        <p class="truncate text-sm text-white"><%= current_user.email_address %></p>

        <div class="mt-2">
          <%= render Badge::Component.new(
            text: @current_plan,
            variant: :green,
          ) %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3">
    <div class="flex items-center gap-3">
      <div class="h-9 w-9 rounded-md bg-accent"></div>

      <div>
        <p class="text-[10px] font-medium tracking-wider text-gray-500 uppercase">Tienda activa</p>
        <p class="text-sm font-medium text-primary"><%= current_user.store.name.capitalize %></p>
      </div>
    </div>

    <%= link_to admin_billing_path, class: "text-sm text-primary hover:text-primary/80" do %>
      Cambiar <span aria-hidden="true">→</span>
    <% end %>
  </div>

  <div class="px-2 pt-3 pb-1">
    <p class="px-3 pb-1 text-[10px] font-medium tracking-wider text-gray-400 uppercase">Tu tienda</p>

    <%= link_to admin_customize_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-800 transition-colors hover:bg-gray-50" do %>
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-orange-50"><%= render_svg("paint.svg", styles: "w-4 h-4 text-gray-700") %></span>
      Personalizar tienda
    <% end %>

    <div class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-400">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-orange-50">
        <%= render_svg("user.svg", styles: "w-4 h-4 text-gray-400") %>
      </span>

      <span class="flex-1">Dominio personalizado</span>
      <span class="text-xs text-gray-400">próx.</span>
    </div>
  </div>

  <div class="border-t border-gray-100 px-2 pt-3 pb-2">
    <p class="px-3 pb-1 text-[10px] font-medium tracking-wider text-gray-400 uppercase">Cuenta</p>

    <%= link_to admin_billing_path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-gray-800 transition-colors hover:bg-gray-50" do %>
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-orange-50"><%= render_svg("user.svg", styles: "w-4 h-4 text-gray-700") %></span>
      Suscripción y pagos
    <% end %>
  </div>

  <div class="mx-3 my-3 rounded-xl bg-primary p-4">
    <p class="font-semibold text-white">
      Crece a <span class="font-serif text-accent italic">Pro</span>
    </p>

    <p class="mt-1 text-xs leading-relaxed text-gray-300">
      Dominio propio, descuentos automáticos y reportes avanzados.
    </p>

    <%= link_to "Ver planes", admin_billing_path, class: "mt-3 inline-block rounded-md bg-orange-50 px-3 py-1.5 text-xs font-medium text-gray-900 transition-colors hover:bg-white" %>
  </div>

  <!-- Cerrar sesión -->
  <div class="border-t border-gray-100 px-2 py-2">
    <%= button_to session_path, method: :delete, class: "flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2 text-left text-sm text-red-600 transition-colors hover:bg-red-50" do %>
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-red-50"><%= render_svg("logout.svg", styles: "w-4 h-4 text-red-500") %></span>
      Cerrar sesión
    <% end %>
  </div>
</div>
