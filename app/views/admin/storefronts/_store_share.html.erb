<div class="flex flex-col gap-0">
  <div class="mx-6 h-px bg-gray-100"></div>

  <%# ── Link público ── %>
  <div class="px-6 py-5">
    <section>
      <label class="mb-2 block text-[11px] font-bold tracking-wider text-gray-500 uppercase sm:text-xs">
        Link público
      </label>

      <div class="rounded-2xl">
        <div class="flex items-center gap-2">
          <div class="relative flex-1">
            <input
              type="text"
              readonly
              value="<%= store_root_url(subdomain: @store.slug) %>"
              class="
                w-full truncate rounded-xl border border-gray-200 bg-white py-3 pr-3 pl-3 text-sm font-medium
                text-gray-700 shadow-sm transition-shadow focus:ring-2 focus:ring-blue-500/20 focus:outline-none
              "
            >
          </div>

          <%= render Clipboard::Component.new(
            text: store_root_url(subdomain: @store.slug),
            icon_only: true,
            variant: :ghost,
            size: :lg,
          ) %>
        </div>
      </div>
    </section>
  </div>

  <div class="mx-6 h-px bg-gray-100"></div>

  <%# ── Compartir directo ── %>
  <div class="px-6 py-5">
    <p class="mb-3 text-sm font-semibold text-gray-700">Compartir directo</p>

    <% share_text = "Hola 🌿 acabo de abrir mi tienda en línea. Pasa a verla cuando puedas: #{store.name}" %>
    <% encoded_text = CGI.escape(share_text) %>
    <% encoded_url  = CGI.escape(store.name) %>

    <div class="flex items-center justify-around">
      <%# WhatsApp %>
      <%= link_to "https://wa.me/?text=#{encoded_text}", target: "_blank", rel: "noopener",
            class: "flex flex-col items-center gap-2" do %>
        <span
          class="
            flex h-14 w-14 items-center justify-center rounded-2xl border border-gray-100 bg-white shadow-sm
            transition hover:shadow-md
          "
        >
          <%= render_svg("whatsapp.svg") %>
        </span>

        <span class="text-xs text-gray-600">WhatsApp</span>
      <% end %>

      <%# Instagram (abre app) %>
      <%= link_to "instagram://", target: "_blank", rel: "noopener",
            class: "flex flex-col items-center gap-2" do %>
        <span
          class="
            flex h-14 w-14 items-center justify-center rounded-2xl border border-gray-100 bg-white shadow-sm
            transition hover:shadow-md
          "
        >
          <%= render_svg("instagram.svg") %>
        </span>

        <span class="text-xs text-gray-600">Instagram</span>
      <% end %>

      <%# Facebook %>
      <%= link_to "https://www.facebook.com/sharer/sharer.php?u=#{encoded_url}", target: "_blank", rel: "noopener",
            class: "flex flex-col items-center gap-2" do %>
        <span
          class="
            flex h-14 w-14 items-center justify-center rounded-2xl border border-gray-100 bg-white shadow-sm
            transition hover:shadow-md
          "
        >
          <%= render_svg("facebook.svg") %>
        </span>

        <span class="text-xs text-gray-600">Facebook</span>
      <% end %>
    </div>
  </div>

  <div class="mx-6 h-px bg-gray-100"></div>

  <%# ── Footer ── %>
  <div class="flex items-center justify-between border-t border-gray-100 px-6 py-4">
    <div class="flex items-center gap-2">
      <span class="h-2 w-2 animate-pulse rounded-full bg-green-500"></span>
      <span class="text-sm text-gray-500">Tu tienda recibe visitas</span>
    </div>

    <%= link_to store.name, target: "_blank", rel: "noopener",
          class: "inline-flex items-center gap-1.5 rounded-full bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-800 active:bg-black" do %>
      Ver mi tienda <%= render_svg("arrow_top.svg", styles: "h-4 w-4") %>
    <% end %>
  </div>
</div>
