<% if user.errors.any? %>
  <div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-3.5">
    <div class="mb-1.5 flex items-center gap-2">
      <%= render_svg("exclamation_circle.svg", styles: "w-5 h-5 text-red-500 shrink-0") %>
      <span class="text-[0.8125rem] font-semibold text-red-700">No se pudo crear la cuenta</span>
    </div>

    <ul class="space-y-0.5 pl-6">
      <% user.errors.full_messages.each do |message| %>
        <li class="list-disc text-[0.75rem] text-red-600"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: @user, class: "w-full") do |form| %>
  <div class="mb-5">
    <div class="mb-2">
      <label class="text-sm font-medium text-primary" for="email_address">Correo Electrónico</label>
      <span class="text-red-500">*</span>
    </div>

    <%= form.email_field :email_address,
        id: "email_address",
        required: true,
        autofocus: true,
        autocomplete: "email_address",
        placeholder: "example@email.com",
        class: "form-control" %>
  </div>

  <div class="mb-8">
    <%= render Password::Component.new(
      id: "password",
      label: "Contraseña",
      required: true,
      name: "user[password]",
      placeholder: "••••••••",
    ) %>
  </div>

  <%= render Buttons::Component.new(
    text: "Registrarse",
    type: "submit",
    full_width: true,
  ) %>
<% end %>
