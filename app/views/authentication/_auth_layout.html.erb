<div class="flex min-h-[100dvh] flex-col font-sans md:h-[100dvh] md:flex-row">
  <div
    class="
      relative flex flex-col justify-center overflow-hidden bg-gradient-to-br from-[#EAF2F8] via-[#F3F4F6] via-40%
      to-[#ECFDF5] p-6 pb-8 md:h-full md:w-[45%] md:p-12 lg:p-14
    "
  >
    <div
      class="
        pointer-events-none absolute -top-[50%] -right-[30%] h-[200%] w-[80%]
        bg-[radial-gradient(ellipse,_rgba(255,255,255,0.15)_0%,_transparent_70%)]
      "
    ></div>

    <div class="relative z-10 mb-8 flex items-center gap-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-[10px] bg-primary">
        <%= render_svg "store.svg", styles: "w-5 h-5 text-white" %>
      </div>

      <span class="text-lg font-bold text-[#1a1a2e]">PocketShop</span>
    </div>

    <h1
      class="
        relative z-10 mb-8 max-w-[420px] text-[2rem] leading-tight font-extrabold text-[#0f0f23] md:text-[2.5rem]
        lg:text-[2.75rem]
      "
    >
      Empieza a vender online en minutos, no&nbsp;en&nbsp;semanas.
    </h1>

    <div class="relative z-10 mt-auto">
      <p class="mb-4 max-w-[380px] text-[0.9rem] leading-relaxed text-[#4a4a6a] italic">
        "PocketShop cambió mi negocio. Pasé de tomar pedidos por DM a tener una tienda profesional en una tarde."
      </p>

      <div class="flex items-center gap-3">
        <div
          class="
            flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#1A2B3C]
            to-[#10B981] text-sm font-semibold text-white
          "
        >
          SM
        </div>

        <div>
          <div class="text-sm font-semibold text-[#1a1a2e]">Sarah M.</div>
          <div class="text-xs text-[#6b6b8a]">Dueña de Sarah's Crafts</div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-1 flex-col justify-center bg-white p-6 py-10 md:overflow-y-auto md:p-12 lg:p-20">
    <div class="mx-auto w-full max-w-[420px] md:my-auto">
      <%= turbo_frame_tag "auth_form", target: "_top" do %>
        <h2 class="mb-1.5 text-[1.50rem] font-bold text-[#0f0f23]"><%= title %></h2>

        <p class="mb-7 text-sm text-[#7c7c9a]"><%= subtitle %></p>

        <div class="mb-7 flex rounded-full bg-[#f4f4f8] p-1">
          <%= render Buttons::Component.new(
            text: "Iniciar Sesión",
            pill: true,
            variant: :ghost,
            classes: "w-1/2 #{active_tab == :login ? 'bg-white shadow-sm text-[#1A2B3C]' : 'text-gray-500 hover:text-gray-700'}",
            href: new_session_path,
            data: { turbo_frame: "auth_form" }
          ) %>

          <%= render Buttons::Component.new(
            text: "Registrarse",
            pill: true,
            variant: :ghost,
            classes: "w-1/2 #{active_tab == :register ? 'bg-white shadow-sm text-[#1A2B3C]' : 'text-gray-500 hover:text-gray-700'}",
            href: new_user_path,
            data: { turbo_frame: "auth_form" }
          ) %>
        </div>

        <div data-controller="animation-products" data-animation-products-target="card">
          <%= yield %>
        </div>
      <% end %>

      <p class="mt-6 text-center text-[0.6875rem] leading-relaxed text-[#9a9ab0]">
        Al continuar, aceptas nuestros
        <a href="#" class="font-medium text-[#1a1a2e] underline underline-offset-2 transition-colors hover:text-[#0f9f72]">Términos de Servicio</a>
        y
        <a href="#" class="font-medium text-[#1a1a2e] underline underline-offset-2 transition-colors hover:text-[#0f9f72]">Política de Privacidad</a>.
      </p>
    </div>
  </div>
</div>
