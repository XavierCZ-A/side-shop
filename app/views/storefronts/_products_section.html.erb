<% interactive = local_assigns.fetch(:interactive, true) %>
<% eyebrow = local_assigns.fetch(:eyebrow, "Colección") %>
<% title = local_assigns.fetch(:title, "Productos destacados") %>

<section id="products" class="mx-auto max-w-7xl px-3 py-10 sm:px-6 sm:py-16 lg:px-8">
  <div class="mb-7 flex items-end justify-between sm:mb-10">
    <div>
      <p class="mb-1.5 text-[10px] tracking-[0.3em] text-gray-500 uppercase sm:mb-2 sm:text-[11px]">
        <%= eyebrow %>
      </p>

      <h2
        class="text-2xl sm:text-3xl sm:text-4xl"
        style="font-family: var(--sp-font-heading); color: var(--sp-color-primary, #1A2B3C);"
      >
        <%= title %>
      </h2>
    </div>

    <% if products.any? %>
      <p class="text-xs text-gray-500 sm:text-sm">
        <%= pluralize(@pagy&.count || products.size, "producto") %>
      </p>
    <% end %>
  </div>

  <% if products.any? %>
    <% if interactive %>
      <%= turbo_frame_tag "products-#{@pagy.page}" do %>
        <div
          class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-4 sm:gap-y-12 lg:grid-cols-4"
          data-controller="animation-products"
        >
          <%= render partial: "storefronts/product_card",
              collection: products,
              as: :product,
              cached: true,
              locals: { current_store: current_store, interactive: true } %>
        </div>

        <% if @pagy.next %>
          <%= turbo_frame_tag "products-#{@pagy.next}",
              src: @pagy.page_url(:next),
              loading: :lazy do %>
            <div class="flex h-12 items-center justify-center text-sm text-gray-400">
              Cargando más productos…
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <div class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-4 sm:gap-y-12 lg:grid-cols-4">
        <% products.each do |product| %>
          <%= render "storefronts/product_card",
                product: product,
                current_store: current_store,
                interactive: false %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div
      class="
        flex flex-col items-center justify-center rounded-2xl border border-dashed border-gray-300 bg-white/40 px-6
        py-16 text-center sm:py-20
      "
    >
      <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400">
        <%= render_svg("photo.svg", styles: "w-6 h-6") %>
      </span>

      <p class="font-serif text-lg text-primary">Próximamente</p>

      <p class="mt-1 text-sm text-gray-500">
        Estamos preparando nuevos productos para ti.
      </p>
    </div>
  <% end %>
</section>
