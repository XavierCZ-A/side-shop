<nav class="sticky top-0 z-50 w-full border-b border-gray-200 bg-white px-4 md:px-8">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between">
    <div class="flex w-full items-center justify-between">
      <div class="flex items-center">
        <div>
          <h1 class="text-xl font-bold">Kubo</h1>
        </div>

        <div class="ml-10 flex items-center gap-3">
          <%= nav_link "Inicio", admin_root_path %>
          <%= nav_link "Productos", admin_products_path %>
          <%= nav_link "Pedidos", admin_storefront_path %>
          <%= nav_link "Tienda", edit_admin_storefront_path %>
        </div>
      </div>

      <div class="relative flex items-center gap-4">
        <%= render Buttons::Component.new(
          text: "Compartir Tienda",
          icon: render_svg("share.svg", styles: "w-4 h-4"),
          data: { turbo_frame: "modal" },
          href: share_admin_storefront_path,
          classes: "[&_span:not(.shrink-0)]:hidden md:[&_span:not(.shrink-0)]:inline",
        ) %>

        <div data-controller="dropdown" data-action="click@window->dropdown#close" class="relative">
          <button class="cursor-pointer" data-action="click->dropdown#toggle">
            <%= user_avatar(current_user.email_address, "#1b69d8", "white") %>
          </button>

          <%= render "admin/dropdown" %>
        </div>
      </div>
    </div>
  </div>
</nav>
