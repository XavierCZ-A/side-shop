<div id="cart_slide_content" class="flex h-full flex-col">
  <header class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
    <div>
      <h2 id="cart_slide_title" class="text-lg font-bold text-[#1A2B3C]">Tu carrito</h2>

      <p class="text-xs text-gray-500">
        <%= @cart&.line_items&.sum(:quantity) || 0 %> productos
      </p>
    </div>

    <button
      type="button"
      data-action="click->cart-slide#close"
      class="cursor-pointer rounded-full p-2 text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700"
      aria-label="Cerrar carrito"
    >
      <%= render_svg("close.svg", styles: "w-5 h-5") %>
    </button>
  </header>

  <% if @cart&.line_items&.any? %>
    <div class="flex-1 divide-y divide-gray-100 overflow-y-auto">
      <% @cart.line_items.includes(:product).each do |item| %>
        <div class="flex gap-3 px-5 py-4">
          <div class="h-20 w-20 shrink-0 overflow-hidden rounded-lg bg-gray-100">
            <% if item.product.images.attached? %>
              <%= image_tag item.product.images.first.variant(resize_to_fill: [160, 160]),
                    alt: item.product.name,
                    class: "h-full w-full object-cover" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center text-gray-300">
                <%= render_svg("photo.svg", styles: "w-8 h-8") %>
              </div>
            <% end %>
          </div>

          <div class="flex min-w-0 flex-1 flex-col justify-between">
            <div class="flex items-start justify-between gap-2">
              <h3 class="line-clamp-2 text-sm font-semibold text-[#1A2B3C]">
                <%= item.product.name %>
              </h3>

              <%= button_to line_item_path(item),
                    method: :delete,
                    class: "shrink-0 p-1 rounded-md text-gray-300 hover:text-red-500 hover:bg-red-50 transition-colors cursor-pointer" do %>
                <%= render_svg("trash.svg", styles: "w-4 h-4") %>
              <% end %>
            </div>

            <div class="mt-2 flex items-end justify-between gap-2">
              <div class="flex items-center overflow-hidden rounded-lg border border-gray-200">
                <%= button_to line_item_path(item, operation: "decrement"),
                      method: :patch,
                      class: "flex h-7 w-7 items-center justify-center text-black transition-colors hover:bg-gray-100 cursor-pointer" do %>
                  <%= render_svg("minus.svg", styles: "w-3 h-3") %>
                <% end %>

                <span
                  class="
                    flex h-7 w-8 items-center justify-center border-x border-gray-200 bg-gray-50 text-xs
                    font-semibold text-[#1A2B3C]
                  "
                >
                  <%= item.quantity %>
                </span>

                <%= button_to line_item_path(item, operation: "increment"),
                      method: :patch,
                      class: "flex h-7 w-7 items-center justify-center text-black transition-colors hover:bg-gray-100 cursor-pointer" do %>
                  <%= render_svg("plus.svg", styles: "w-3 h-3") %>
                <% end %>
              </div>

              <span class="text-sm font-bold text-[#1A2B3C]"><%= number_to_currency(item.total_price) %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <footer class="border-t border-gray-100 bg-gray-50 px-5 py-4">
      <div class="mb-3 flex items-center justify-between text-sm">
        <span class="text-gray-500">Subtotal</span>
        <span class="font-medium text-[#1A2B3C]"><%= number_to_currency(@cart.total_price) %></span>
      </div>

      <div class="mb-4 flex items-center justify-between">
        <span class="text-base font-bold text-[#1A2B3C]">Total</span>
        <span class="text-xl font-bold text-[#1A2B3C]"><%= number_to_currency(@cart.total_price) %></span>
      </div>

      <%= render Buttons::Component.new(
        text: "Proceder al pago",
        full_width: true,
        classes: "mb-2",
        href: checkout_path,
      ) %>

      <p class="text-center text-[11px] text-gray-400">Envío gratis · Pago seguro</p>
    </footer>
  <% else %>
    <div class="flex flex-1 flex-col items-center justify-center gap-3 px-6 text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-100 text-gray-400">
        <%= render_svg("shopping_bag.svg", styles: "w-8 h-8") %>
      </div>

      <h3 class="text-base font-semibold text-[#1A2B3C]">Tu carrito está vacío</h3>

      <p class="max-w-xs text-sm text-gray-500">Agrega productos para verlos aquí.</p>

      <%= render Buttons::Component.new(
        text: "Continuar comprando",
        variant: :outline,
        classes: "mt-2",
        data: { action: "click->cart-slide#close" }
      ) %>
    </div>
  <% end %>
</div>
