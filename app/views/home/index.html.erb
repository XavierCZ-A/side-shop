<nav class="sticky top-0 z-50 w-full border-b border-[#E5E7EB] bg-white/90 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex flex-shrink-0 items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-white">
          <%= render_svg("cart.svg", styles: "w-5 h-5") %>
        </div>

        <span
          class="
            hidden bg-gradient-to-r from-gray-900 to-gray-700 bg-clip-text text-xl font-bold text-transparent
            sm:inline
          "
        >
          PocketShop
        </span>
      </div>

      <div class="hidden items-center space-x-8 md:flex">
        <a href="#features" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
          Características
        </a>

        <a href="#pricing" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
          Planes
        </a>

        <a href="#faq" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
          Preguntas
        </a>
      </div>

      <div class="flex items-center gap-4">
        <%= render Buttons::Component.new(
          text: "Iniciar sesión",
          full_width: true,
          pill: true,
          variant: :outline,
          href: new_session_path
        ) %>

        <%= render Buttons::Component.new(
          text: "Crear tienda",
          full_width: true,
          pill: true,
          href: new_user_path
        ) %>
      </div>
    </div>
  </div>
</nav>

<section class="relative overflow-hidden bg-secondary/30 pt-12 pb-16 lg:pt-20 lg:pb-32">
  <div class="absolute top-0 left-1/2 h-full w-full max-w-7xl -translate-x-1/2">
    <div class="absolute top-20 right-0 h-[500px] w-[500px] rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 h-[400px] w-[400px] rounded-full bg-[#10B981]/10 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-8">
      <div class="mx-auto max-w-2xl text-center lg:mx-0 lg:text-left">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#A7F3D0] bg-[#ECFDF5] px-3 py-1">
          <span class="text-xs font-semibold tracking-wide text-accent uppercase">Ideal para emprendedores</span>
        </div>

        <h1 class="mb-6 text-4xl leading-[1.1] font-black tracking-tight text-foreground sm:text-5xl lg:text-6xl">
          Tu tienda online <span class="block text-primary">en un solo link.</span>
        </h1>

        <p class="mx-auto mb-8 max-w-lg text-lg leading-relaxed text-muted-foreground sm:text-xl lg:mx-0">
          Olvídate de Shopify o WooCommerce. Sube tus 5, 10 o 15 productos top y comparte tu link. Simple, rápido y
          hermoso.
        </p>

        <div class="mb-10 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <%= render Buttons::Component.new(
              text: "Comenzar gratis",
              variant: :accent,
              size: :lg,
              href: new_user_path
          ) %>

          <%= render Buttons::Component.new(
              text: "Ver demo",
              size: :lg,
              variant: :primary,
              href: "#"
          ) %>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-muted-foreground lg:justify-start">
          <div class="flex items-center gap-2">
            <%= render_svg("check_circle.svg", styles: "w-5 h-5 text-success") %>
            <span>Sin tarjetas de crédito</span>
          </div>

          <div class="flex items-center gap-2">
            <%= render_svg("check_circle.svg", styles: "w-5 h-5 text-success") %>
            <span>Configuración en 2 min</span>
          </div>
        </div>
      </div>

      <!-- Right Content (Mockup Visual) -->
      <div class="relative flex items-center justify-center lg:h-[600px]">
        <!-- Abstract Shapes backing -->
        <div
          class="
            absolute inset-0 scale-95 -rotate-3 rounded-[3rem] border border-primary/10 bg-gradient-to-tr
            from-[#EAF2F8] to-white shadow-sm
          "
        ></div>

        <!-- Main Card Container (Floating) -->
        <div
          class="
            relative w-full max-w-md rotate-2 rounded-[2rem] border border-gray-100 bg-white p-6 shadow-2xl
            shadow-primary/10 transition-transform duration-500 hover:rotate-0
          "
        >
          <!-- Profile Header -->
          <div class="mb-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="relative h-12 w-12 overflow-hidden rounded-full bg-muted">
                <img
                  src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80"
                  alt="Sarah"
                  class="h-full w-full object-cover"
                >
              </div>

              <div>
                <h3 class="font-bold text-foreground">Tienda de Sarah</h3>
                <p class="text-xs text-muted-foreground">@sarah_crafts</p>
              </div>
            </div>

            <button class="rounded-full bg-primary px-4 py-1.5 text-xs font-semibold text-white">Seguir</button>
          </div>

          <!-- Product Grid Mockup -->
          <div class="grid grid-cols-2 gap-4">
            <div class="aspect-square rounded-xl bg-[#F3F4F6]"></div>
            <div class="aspect-square rounded-xl bg-[#F3F4F6]"></div>
            <div class="aspect-square rounded-xl bg-[#F3F4F6]"></div>
            <div class="aspect-square rounded-xl bg-[#F3F4F6]"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="pricing" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-black tracking-tight text-foreground md:text-5xl">
        Planes simples para <span class="text-primary">crecer contigo</span>
      </h2>

      <p class="text-xl text-muted-foreground">
        Comienza gratis y mejora tu plan a medida que aumenten tus ventas. Sin comisiones ocultas por transacción.
      </p>
    </div>

    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-3">
      <% @plans.each do |plan| %>
        <%= render "shared/pricing_card", plan: plan %>
      <% end %>
    </div>
  </div>
</section>

<section id="faq" class="relative overflow-hidden bg-secondary/30 pt-12 pb-16 lg:pt-20 lg:pb-32">
  <div>
    <h1 class="mb-4 text-center text-3xl font-black tracking-tight text-foreground md:text-5xl">
      Respuestas a tus dudas
    </h1>

    <p class="mb-12 text-center text-xl text-muted-foreground">
      Aquí encontrarás respuestas a las preguntas más frecuentes sobre PocketShop.
    </p>
  </div>

  <div class="mx-auto max-w-3xl">
    <%= render Accordion::Component.new(icon: :plus_minus, variant: :bordered, allow_multiple: true) do |accordion| %>
      <% accordion.with_item(title: "¿Realmente puedo tener mi tienda en 5 minutos?", default_open: false) do %>
        ¡Sí! Solo necesitas el nombre de tu negocio y subir tu primer producto. Nuestro asistente inteligente configura
        el diseño y los pagos por ti para que puedas compartir tu link de inmediato.
      <% end %>

      <% accordion.with_item(title: "¿Necesito saber programar o ser diseñador?", default_open: false) do %>
        Para nada. Si sabes usar Facebook o WhatsApp, sabes usar nuestra plataforma. Es 100% visual y amigable.
      <% end %>

      <% accordion.with_item(title: "¿Qué métodos de pago puedo ofrecer a mis clientes?", default_open: false) do %>
        Puedes aceptar pagos por WhatsApp, transferencias bancarias (SPEI) y depósitos en OXXO. También puedes activar
        pagos con tarjeta de crédito y débito de forma sencilla.
      <% end %>

      <% accordion.with_item(title: "¿Cobran comisión por cada venta?", default_open: false) do %>
        Nosotros no cobramos comisiones por tus ventas. Tu dinero es tuyo. Solo pagas tu suscripción mensual [o la
        comisión de la pasarela si usas Stripe/Mercado Pago].
      <% end %>

      <% accordion.with_item(title: "¿Que pasa si no me gusta? ¿Hay periodo de prueba?", default_open: false) do %>
        Toda la plataforma es gratis, no necesitas tarjeta de crédito. Puedes probarla sin riesgo y decidir si quieres
        mejorar tu plan después.
      <% end %>
    <% end %>
  </div>
</section>
