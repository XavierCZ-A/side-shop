<!-- app/views/onboardings/fields/_text_field.html.erb -->
<div class="w-full">
  <%= form.label field[:name], field[:label], class: "block text-sm font-semibold text-gray-700 mb-2" %>

  <%= form.text_field field[:name],
    placeholder: field[:placeholder],
    required: field[:required],
    class: "w-full px-3.5 py-3 text-sm text-[#1a1a2e] bg-[#fafafa] border-[1.5px] border-[#e5e5ec] rounded-[10px] outline-none transition-all duration-200 placeholder:text-[#b0b0c4] focus:border-[#10B981] focus:ring-[3px] focus:ring-[#10B981]/15 focus:bg-white",
    data: {
      onboarding_target: "input",
      action: "input->onboarding#updateSlug"
    } %>

  <% if field[:name] == :name %>
    <div class="mt-5">
      <p class="mb-3 text-xs font-semibold tracking-wider text-gray-500 uppercase">Así se verá tu tienda</p>

      <!-- Preview Card -->
      <div class="mb-10 overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-lg">
        <!-- Browser chrome -->
        <div class="flex items-center gap-3 border-b border-gray-200 bg-[#F3F4F6] px-4 py-2.5">
          <div class="flex gap-1.5">
            <div class="h-3 w-3 rounded-full bg-red-400"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-400"></div>
            <div class="h-3 w-3 rounded-full bg-green-400"></div>
          </div>

          <!-- URL Bar -->
          <div class="flex flex-1 items-center gap-2 rounded-lg bg-white px-3 py-1.5 shadow-inner">
            <svg class="h-3.5 w-3.5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                clip-rule="evenodd"
              />
            </svg>

            <div class="flex items-center text-sm">
              <span class="font-semibold text-[#10B981]" data-onboarding-target="slugPreview">tu-tienda</span>
              <span class="text-gray-400">.shopy.com</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
