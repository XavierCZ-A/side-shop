<div data-controller="image-preview" data-image-preview-max-files-value="2">
  <div class="mb-1.5 flex items-center gap-1">
    <%= form.label :images, "Imágenes", class: "block text-sm font-semibold text-gray-700" %>
    <span class="text-red-500">*</span>
    <span data-image-preview-target="counter" class="ml-auto text-xs text-gray-400">0 / 2</span>
  </div>

  <div
    data-image-preview-target="dropzone"
    data-action="dragover->image-preview#dragover dragleave->image-preview#dragleave drop->image-preview#drop"
    class="
      relative flex cursor-pointer items-center gap-3 rounded-xl border-2 border-dashed border-gray-200 bg-[#fafafa]
      p-3 transition-all hover:border-[#10B981] hover:bg-white
    "
    onclick="this.querySelector('input[type=file]').click()"
  >
    <div data-placeholder class="flex w-full items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#ECFDF5]">
        <%= render_svg("upload.svg", styles: "h-5 w-5 text-[#10B981]") %>
      </div>

      <div class="min-w-0 flex-1">
        <p class="text-sm text-gray-700">
          <span class="font-semibold text-[#10B981]">Toca para subir</span>
          <span class="text-gray-500">o arrastra aquí</span>
        </p>

        <p class="text-[11px] text-gray-400">JPG, PNG · Máx. 10 MB · Hasta 2</p>
      </div>
    </div>

    <%= form.file_field :images,
          multiple: true,
          accept: "image/jpeg,image/png,image/webp",
          data: { image_preview_target: "input", action: "change->image-preview#selectFiles" },
          class: "sr-only",
          direct_upload: true %>
  </div>

  <div data-image-preview-target="preview" class="mt-2 flex flex-wrap gap-2"></div>
</div>
