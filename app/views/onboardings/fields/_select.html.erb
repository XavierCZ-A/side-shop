<div class="w-full">
  <%= form.label field[:name], field[:label], class: "mb-1.5 block text-sm font-semibold text-gray-700" %>

  <div class="grid grid-cols-2 gap-2 sm:gap-3">
    <% industry_icons = {
      "Ropa" => "👗",
      "Alimentos" => "🍕",
      "Servicios" => "🛠️",
      "Otro" => "✨"
    } %>

    <% field[:options].each_with_index do |option, index| %>
      <% element_id = "#{field[:name]}_#{option.parameterize.underscore}" %>

      <div class="relative">
        <%= form.radio_button field[:name], option,
            id: element_id,
            class: "peer sr-only",
            checked: index == 0,
            required: field[:required],
            data: { action: "change->onboarding#updateIndustry" }
        %>

        <label
          for="<%= element_id %>"
          class="flex cursor-pointer items-center gap-2 rounded-2xl border-2 border-gray-200 bg-white/60 p-2.5 backdrop-blur-sm transition-all duration-200 hover:border-gray-300 hover:bg-white peer-checked:border-[#10B981] peer-checked:bg-[#ECFDF5] peer-checked:shadow-md peer-checked:shadow-[#10B981]/20 sm:p-3"
        >
          <span class="text-xl sm:text-2xl"><%= industry_icons[option] || "📦" %></span>
          <span class="text-sm font-semibold text-[#1A2B3C]"><%= option %></span>
        </label>
      </div>
    <% end %>
  </div>

  <div data-onboarding-target="otherInput" class="mt-2 hidden transition-all duration-300">
    <%= form.text_field :other_industry,
        class: "w-full rounded-[10px] border-[1.5px] border-[#e5e5ec] bg-[#fafafa] px-3.5 py-2.5 text-sm text-[#1a1a2e] outline-none transition-all duration-200 placeholder:text-[#b0b0c4] focus:border-[#10B981] focus:bg-white focus:ring-[3px] focus:ring-[#10B981]/15",
        placeholder: "Especifica tu industria..." %>
  </div>
</div>
