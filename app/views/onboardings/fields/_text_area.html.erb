<div class="w-full">
  <%= form.label field[:name], field[:label], class: "mb-1.5 block text-sm font-semibold text-gray-700" %>

  <%= form.text_area field[:name],
    class: "w-full resize-none rounded-[10px] border-[1.5px] border-[#e5e5ec] bg-[#fafafa] px-3.5 py-2.5 text-sm text-[#1a1a2e] outline-none transition-all duration-200 placeholder:text-[#b0b0c4] focus:border-[#10B981] focus:bg-white focus:ring-[3px] focus:ring-[#10B981]/15",
    placeholder: field[:placeholder],
    required: field[:required],
    rows: 2 %>
</div>
