<div class="w-full">
  <%= form.label field[:name], field[:label], class: "mb-1.5 block text-sm font-semibold text-gray-700" %>

  <div class="relative">
    <span class="absolute top-1/2 left-3.5 -translate-y-1/2 text-sm font-semibold text-gray-400">$</span>

    <%= form.number_field field[:name],
      class: "w-full rounded-[10px] border-[1.5px] border-[#e5e5ec] bg-[#fafafa] py-2.5 pr-3.5 pl-7 text-sm text-[#1a1a2e] outline-none transition-all duration-200 placeholder:text-[#b0b0c4] focus:border-[#10B981] focus:bg-white focus:ring-[3px] focus:ring-[#10B981]/15",
      placeholder: field[:placeholder]&.gsub("$", "")&.strip,
      required: field[:required],
      min: 0 %>
  </div>
</div>
