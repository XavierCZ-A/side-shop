<div class="w-full">
  <%= form.label field[:name], field[:label], class: "mb-2 block text-sm font-semibold text-gray-700" %>

  <div class="grid grid-cols-6 gap-2 sm:gap-3">
    <% field[:options].each_with_index do |color, idx| %>
      <% element_id = "#{field[:name]}_#{color.gsub('#', '')}" %>

      <div class="relative">
        <%= form.radio_button field[:name], color,
            id: element_id,
            class: "peer sr-only",
            checked: idx == 0,
            required: field[:required],
            data: { action: "change->onboarding#updateColor" }
        %>

        <label
          for="<%= element_id %>"
          class="block aspect-square w-full cursor-pointer rounded-2xl shadow-md ring-2 ring-transparent ring-offset-2 ring-offset-[#F3F4F6] transition-all duration-200 hover:scale-110 peer-checked:scale-110 peer-checked:ring-4 peer-checked:ring-offset-4"
          style="background-color: <%= color %>; box-shadow: 0 4px 14px <%= color %>40;"
        >
          <span class="sr-only">Color <%= color %></span>

          <div class="hidden h-full w-full items-center justify-center peer-checked:flex">
            <svg class="h-5 w-5 text-white drop-shadow-md sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
        </label>
      </div>
    <% end %>
  </div>

  <div class="mt-3">
    <p class="mb-1.5 text-xs font-semibold tracking-wider text-gray-500 uppercase">Vista previa</p>

    <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm">
      <div
        class="flex h-12 items-center justify-between px-3 text-white transition-colors duration-300 sm:h-14"
        data-onboarding-target="colorPreview"
        style="background-color: #4F46E5;"
      >
        <div class="flex items-center gap-2">
          <div class="h-7 w-7 rounded-lg bg-white/25"></div>

          <span class="text-sm font-semibold">Tu Tienda</span>
        </div>

        <span
          class="rounded-full bg-white/20 px-2.5 py-1 text-[10px] font-medium tracking-wider uppercase"
        >Online</span>
      </div>

      <div class="flex items-center justify-between bg-gradient-to-b from-gray-50 to-white px-3 py-2.5">
        <span class="text-xs text-gray-500">shopy.mx/<span data-onboarding-target="slugPreview">tu-tienda</span></span>

        <span
          class="rounded-lg px-2.5 py-1 text-xs font-medium text-white shadow-sm transition-colors duration-300"
          data-onboarding-target="colorPreview"
          style="background-color: #4F46E5;"
        >Comprar</span>
      </div>
    </div>
  </div>
</div>
