<div class="min-h-screen bg-gradient-to-b from-[#EAF2F8] via-white to-white">
  <div class="mx-auto max-w-4xl px-4 py-16 sm:py-24">
    <div class="text-center">
      <div class="mb-8 flex justify-center">
        <svg
          class="h-64 w-64 text-gray-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
            opacity="0.3"
          />

          <line
            x1="4"
            y1="4"
            x2="20"
            y2="20"
            stroke-width="2"
            stroke="currentColor"
            class="text-red-500"
          />
        </svg>
      </div>

      <h1 class="mb-4 text-5xl font-extrabold text-[#1A2B3C] sm:text-6xl">
        Oops...
      </h1>

      <p class="mb-2 text-xl text-gray-600">
        Esta tienda no existe
      </p>

      <p class="mx-auto mb-10 max-w-md text-gray-500">
        Puede que el enlace esté mal escrito o que la tienda haya sido eliminada.
      </p>

      <%= render Buttons::Component.new(
        text: "Crear mi tienda gratis",
        href: root_url(subdomain: false),
        size: :lg,
        variant: :accent
      ) %>
    </div>
  </div>
</div>
