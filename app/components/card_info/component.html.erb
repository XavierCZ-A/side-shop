<div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
  <p class="text-[11px] font-medium tracking-wider text-gray-400 uppercase">
    <%= label %>
  </p>

  <p class="mt-1 text-3xl font-semibold <%= value_color %>">
    <%= value %>
  </p>

  <% if subtitle.present? %>
    <p class="mt-1 text-sm text-gray-500">
      <%= subtitle %>
    </p>
  <% end %>
</div>
