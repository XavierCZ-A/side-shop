<div data-controller="tabs" data-tabs-storage-key-value="settings-active-tab">
  <div class="border-b border-gray-200 px-6 sm:px-8">
    <nav class="flex gap-6" role="tablist" aria-label="Tabs">
      <% tabs.each do |tab| %>
        <button
          type="button"
          role="tab"
          data-tabs-target="trigger"
          data-action="tabs#switch"
          data-tab-id="<%= tab.id %>"
          aria-selected="<%= tab.active? %>"
          class="
            relative -mb-px border-b-2 py-4 text-sm font-medium transition-colors
            <%= tab.active? ? 'text-gray-900 border-gray-900' : 'text-gray-500 border-transparent hover:text-gray-700 hover:border-gray-300' %>
          "
        >
          <%= tab.label %>
        </button>
      <% end %>
    </nav>
  </div>

  <div class="tabs-panels px-6 sm:px-8">
    <% tabs.each do |tab| %>
      <div data-tabs-target="panel" data-tab-id="<%= tab.id %>" class="<%= 'hidden' unless tab.active? %>">
        <%= tab %>
      </div>
    <% end %>
  </div>
</div>
