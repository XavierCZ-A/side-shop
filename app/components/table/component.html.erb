<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-100 text-left">
      <thead>
        <tr class="text-[11px] font-medium tracking-wider text-gray-400 uppercase">
          <th scope="col" class="px-6 py-4">Producto</th>
          <th scope="col" class="px-6 py-4"><%= sort_link("Precio", "price") %></th>
          <th scope="col" class="px-6 py-4"><%= sort_link("Stock", "stock") %></th>
          <th scope="col" class="px-6 py-4">Estatus</th>

          <th scope="col" class="px-6 py-4">
            <span class="sr-only">Acciones</span>
          </th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-100">
        <% products.each do |product| %>
          <tr id="<%= dom_id(product) %>" class="transition-colors hover:bg-gray-50/60">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <% if thumbnail(product) %>
                  <%= image_tag thumbnail(product),
                      alt: product.name,
                      class: "size-10 shrink-0 rounded-lg object-cover" %>
                <% else %>
                  <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-gray-100">
                    <%= render_svg("photo.svg", styles: "w-5 h-5 text-gray-300") %>
                  </div>
                <% end %>

                <span class="font-medium text-gray-900"><%= product.name %></span>
              </div>
            </td>

            <td class="px-6 py-4 text-gray-900">
              <%= number_to_currency(product.price) %>
            </td>

            <td class="px-6 py-4 text-gray-900">
              <%= product.stock %>
            </td>

            <td class="px-6 py-4">
              <%= render Badge::Component.new(
                text: status_text(product),
                variant: status_variant(product),
                pill: true
              ) %>
            </td>

            <td class="px-6 py-4">
              <div class="flex items-center justify-end text-gray-400">
                <%= render Buttons::Component.new(
                  icon: product.active? ? render_svg("trash.svg", styles: "hover hover:text-red-500") : render_svg("eye.svg",  styles: "hover hover:text-gray-500"),
                  icon_only: true,
                  size: :lg,
                  variant: :ghost,
                  href: toggle_active_admin_product_path(product),
                  data: {
                    turbo_method: :patch,
                    turbo_confirm: product.active? ? "Al desactivar este producto no estará visible en tu tienda." : "Al activar este producto estará visible en tu tienda.",
                  }
                ) %>

                <%= render Buttons::Component.new(
                  icon_only: true,
                  variant: :ghost,
                  size: :lg,
                  icon: render_svg("pencil.svg", styles: "hover hover:text-gray-500"),
                  href: edit_admin_product_path(product),
                  data: {
                    turbo_frame: "_top"
                  }
                ) %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
